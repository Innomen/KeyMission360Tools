def cmd_info(args):
    """Show camera information"""
    print("=" * 60)
    print("Nikon KeyMission 360 Camera Information")
    print("=" * 60)
    print()

    if not USB1_AVAILABLE:
        print("[!] usb1 module not installed. Using gphoto2 fallback.")
        print("    Install with: pip install libusb1")
        print()
        return _info_gphoto2()

    try:
        with usb1.USBContext() as context:
            device = None
            for dev in context.getDeviceIterator(skip_on_error=True):
                if dev.getVendorID() == VENDOR_ID and dev.getProductID() == PRODUCT_ID:
                    device = dev
                    break

            if not device:
                print("[!] Camera not found via USB!")
                print("    Trying gphoto2 fallback...")
                print()
                return _info_gphoto2()

            # USB Device Information
            print("USB Device Information:")
            print("-" * 60)
            print(f"  Vendor ID:      0x{device.getVendorID():04X}")
            print(f"  Product ID:     0x{device.getProductID():04X}")
            print(f"  Bus:            {device.getBusNumber()}")
            print(f"  Device Address: {device.getDeviceAddress()}")

            # String descriptors
            print()
            print("Device Strings:")
            print("-" * 60)
            try:
                print(
                    f"  Manufacturer:   {device.getStringDescriptor(device.device_descriptor.iManufacturer, 0x0409)}"
                )
                print(
                    f"  Product:        {device.getStringDescriptor(device.device_descriptor.iProduct, 0x0409)}"
                )
                print(
                    f"  Serial Number:  {device.getStringDescriptor(device.device_descriptor.iSerialNumber, 0x0409)}"
                )
            except Exception as e:
                print(f"  Error reading strings: {e}")

            # PTP Communication
            print()
            print("PTP Communication:")
            print("-" * 60)

            handle = device.open()
            handle.setConfiguration(1)

            for i in range(4):
                try:
                    if handle.kernelDriverActive(i):
                        handle.detachKernelDriver(i)
                except:
                    pass

            config = device[0]
            setting = next(config[0].iterSettings())
            interface_num = setting.getNumber()
            handle.claimInterface(interface_num)

            bulk_in = bulk_out = None
            for ep in setting.iterEndpoints():
                addr = ep.getAddress()
                attrs = ep.getAttributes()
                if (attrs & 0x03) == 0x02:
                    if addr & 0x80:
                        bulk_in = addr
                    else:
                        bulk_out = addr

            print(f"  Interface:      {interface_num}")
            print(f"  Bulk OUT:       0x{bulk_out:02X}")
            print(f"  Bulk IN:        0x{bulk_in:02X}")

            # Get storage IDs
            trans_id = 1
            session = struct.pack(
                "<IHHII", 16, PTP_CONTAINER_COMMAND, PTP_OC_OPEN_SESSION, trans_id, 1
            )
            handle.bulkWrite(bulk_out, session, timeout=5000)
            handle.bulkRead(bulk_in, 512, timeout=5000)

            trans_id += 1
            storage_cmd = struct.pack(
                "<IHHII", 16, PTP_CONTAINER_COMMAND, PTP_OC_GET_STORAGE_IDS, trans_id, 0
            )
            handle.bulkWrite(bulk_out, storage_cmd, timeout=5000)

            data = handle.bulkRead(bulk_in, 512, timeout=5000)
            handle.bulkRead(bulk_in, 512, timeout=5000)

            print()
            print("Storage Devices:")
            print("-" * 60)

            if len(data) >= 12:
                count = struct.unpack("<I", bytes(data[8:12]))[0]
                print(f"  Count: {count}")

                for i in range(count):
                    offset = 12 + (i * 4)
                    if offset + 4 <= len(data):
                        storage_id = struct.unpack(
                            "<I", bytes(data[offset : offset + 4])
                        )[0]
                        name = (
                            "(Internal)"
                            if storage_id == 0x00000001
                            else "(SD Card)"
                            if storage_id == 0x00010001
                            else ""
                        )
                        print(f"  Storage {i + 1}:       0x{storage_id:08x} {name}")

            handle.releaseInterface(interface_num)

    except Exception as e:
        print(f"[!] USB Error: {e}")
        print("    Trying gphoto2 fallback...")
        print()
        return _info_gphoto2()

    print()
    print("=" * 60)
    return 0


def _info_gphoto2():
    """Fallback info using gphoto2"""
    if not check_gphoto2():
        print("[!] gphoto2 not installed!")
        return 1

    try:
        result = subprocess.run(
            ["gphoto2", "--summary"], capture_output=True, text=True, timeout=30
        )
        print(result.stdout)
        if result.stderr:
            print("Errors:", result.stderr)
    except Exception as e:
        print(f"[!] Error: {e}")
        return 1

    return 0


