    @staticmethod
    def _check_python_module(name):
        try:
            __import__(name)
            return True
        except ImportError:
            return False

    @staticmethod
    def detect_pm():
        if shutil.which("pacman"):
            return "pacman"
        if shutil.which("apt-get"):
            return "apt"
        if shutil.which("pip3"):
            return "pip"
        if shutil.which("pip"):
            return "pip"
        return None

    @staticmethod
    def check(name):
        if name in KM360DepManager.DEPS:
            return KM360DepManager.DEPS[name]["check"]()
        return False

    @staticmethod
    def install(name, auto=False, gui_mode=False):
        dep = KM360DepManager.DEPS.get(name)
        if not dep:
            return False

        pm = KM360DepManager.detect_pm()
        if not pm or pm not in dep["install"]:
            print(f"  Cannot auto-install {name} - no package manager")
            return False

        cmd = dep["install"][pm]

        # Check if we need elevated privileges (sudo)
        needs_sudo = any(c in ["sudo", "pacman", "apt-get", "apt"] for c in cmd)

        # In GUI mode, try pkexec instead of sudo for graphical auth
        if gui_mode and needs_sudo and cmd[0] == "sudo":
            if shutil.which("pkexec"):
                # Replace sudo with pkexec for GUI auth dialog
                cmd = ["pkexec"] + cmd[1:]
            else:
                print(f"  Cannot install {name} automatically in GUI mode.")
                print(f"  Please run in terminal: {' '.join(cmd)}")
                return False

        print(f"  Installing {name}: {' '.join(cmd)}")

        if not auto and not gui_mode:
            resp = input("  Proceed? [Y/n]: ")
            if resp.lower() in ["n", "no"]:
                return False

        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            if result.returncode != 0:
                stderr = result.stderr.lower() if result.stderr else ""
                if "password" in stderr or "permission" in stderr or "auth" in stderr:
                    print("  ✗ Authentication failed or password required")
                    print(f"  Please install manually: {' '.join(cmd)}")
                else:
                    print(f"  ✗ Error: {result.stderr[:200]}")
                return False
            return True
        except Exception as e:
            print(f"  Install failed: {e}")
            return False

    @staticmethod
    def ensure_for_command(cmd, auto_install=False):
        """Ensure deps for a command, optionally auto-install"""
        needed = KM360DepManager.CMD_DEPS.get(cmd, [])
        missing = [n for n in needed if not KM360DepManager.check(n)]

        if not missing:
            return True

        print(f"[{cmd}] Missing dependencies:")
        for name in missing:
            dep = KM360DepManager.DEPS[name]
            opt = "optional" if dep["optional"] else "REQUIRED"
            print(f"  • {name} ({opt}): {dep['desc']}")

        if auto_install:
            print("\nAuto-installing...")
            for name in missing:
                KM360DepManager.install(name, auto=True)
            # Re-check
            still_missing = [n for n in missing if not KM360DepManager.check(n)]
            if still_missing:
                req_missing = [
                    n for n in still_missing if not KM360DepManager.DEPS[n]["optional"]
                ]
                if req_missing:
                    print(f"✗ Required deps still missing: {', '.join(req_missing)}")
                    return False
            return True
        else:
            resp = input("\nInstall missing dependencies? [Y/n]: ")
            if resp.lower() not in ["n", "no"]:
                for name in missing:
                    KM360DepManager.install(name, auto=False)
                still_missing = [n for n in missing if not KM360DepManager.check(n)]
                req_missing = [
                    n for n in still_missing if not KM360DepManager.DEPS[n]["optional"]
                ]
                return len(req_missing) == 0

        # Allow optional-only missing
        req_missing = [n for n in missing if not KM360DepManager.DEPS[n]["optional"]]
        return len(req_missing) == 0

    @staticmethod
    def check_usb_reset():
        """Check USB reset capabilities and offer fixes"""
        print("\nUSB Reset Check:")

        has_usb_lib = KM360DepManager.check("libusb1")
        has_usbreset = shutil.which("usbreset") is not None

        methods = []
        if has_usb_lib:
            methods.append(("USB library (pyusb/libusb1)", True, "Preferred"))
        else:
            methods.append(
                ("USB library (pyusb/libusb1)", False, "pip install libusb1")
            )

        if has_usbreset:
            methods.append(("usbreset utility", True, "Available"))
        else:
            methods.append(("usbreset utility", False, "Package: usbutils"))

        methods.append(("sysfs toggle", True, "May need sudo"))

        all_ok = True
        for name, ok, note in methods:
            status = "✓" if ok else "✗"
            print(f"  [{status}] {name}: {note}")
            if not ok:
                all_ok = False

        # Check udev rules
        udev_path = Path("/etc/udev/rules.d/99-keymission360.rules")
        if not udev_path.exists():
            print("\n⚠ udev rules not installed - USB may need sudo")
            print("  Install: km360 install --udev")

        return all_ok


def cmd_deps(args):
    """Dependency management command"""
    if args.check or args.usb_reset:
        print("=" * 60)
        print("KeyMission 360 - Dependency Check")
        print("=" * 60)
        print()

        pm = KM360DepManager.detect_pm()
        print(f"Package Manager: {pm or 'unknown'}")
        print()

        print("Dependencies:")
        for name, dep in KM360DepManager.DEPS.items():
            ok = dep["check"]()
            opt = "optional" if dep["optional"] else "REQUIRED"
            status = "✓" if ok else "✗"
            print(f"  [{status}] {name} ({opt}): {dep['desc']}")

        if args.usb_reset:
            KM360DepManager.check_usb_reset()

        print()
        print("To install missing:")
        print("  km360 deps --install         # Interactive")
        print("  km360 deps --install-all     # Auto-install")
        return 0

    if args.install or args.install_all:
        print("=" * 60)
        print("KeyMission 360 - Dependency Installation")
        print("=" * 60)
        print()

        # Detect if running in GUI/non-terminal mode
        is_gui = not sys.stdin.isatty() if hasattr(sys.stdin, "isatty") else False
        if is_gui:
            print("(Running in GUI mode - using graphical authentication)")
            print()

        pm = KM360DepManager.detect_pm()
        if not pm:
            print("✗ No supported package manager found (apt, pacman, pip)")
            return 1

        print(f"Using package manager: {pm}")
        print()

        to_install = []
        for name, dep in KM360DepManager.DEPS.items():
            if not dep["check"]() and pm in dep["install"]:
                to_install.append(name)

        if not to_install:
            print("✓ All dependencies satisfied!")
            return 0

        print(f"Dependencies to install: {', '.join(to_install)}")
        print()

        if is_gui and not shutil.which("pkexec"):
            print("⚠ GUI mode detected but pkexec not available.")
            print("  Install commands require administrator privileges.")
            print("  Please install manually:")
            for name in to_install:
                dep = KM360DepManager.DEPS[name]
                if pm in dep["install"]:
                    print(f"    {' '.join(dep['install'][pm])}")
            return 1

        success = []
        failed = []
        for name in to_install:
            if KM360DepManager.install(name, auto=args.install_all, gui_mode=is_gui):
                success.append(name)
            else:
                failed.append(name)

        print()
        if success:
            print(f"✓ Installed: {', '.join(success)}")
        if failed:
            print(f"✗ Failed: {', '.join(failed)}")

        return 0 if not failed else 1

    if args.for_command:
        ok = KM360DepManager.ensure_for_command(args.for_command, args.install_all)
        return 0 if ok else 1

    # Default: show status
    return cmd_deps(
        argparse.Namespace(
            check=True,
            usb_reset=False,
            install=False,
            install_all=False,
            for_command=None,
        )
    )


# USB IDs
VENDOR_ID = 0x04B0
PRODUCT_ID = 0x019F

# PTP Constants
PTP_CONTAINER_COMMAND = 0x0001
PTP_CONTAINER_DATA = 0x0002
PTP_CONTAINER_RESPONSE = 0x0003
PTP_OC_OPEN_SESSION = 0x1002
PTP_OC_GET_STORAGE_IDS = 0x1004
PTP_OC_FORMAT_STORE = 0x100F
PTP_RC_OK = 0x2001

# Optional imports
try:
    import usb1

    USB1_AVAILABLE = True
except ImportError:
    USB1_AVAILABLE = False

try:
    import usb.core
    import usb.util

    PYUSB_AVAILABLE = True
except ImportError:
    PYUSB_AVAILABLE = False

USB_AVAILABLE = USB1_AVAILABLE or PYUSB_AVAILABLE


def format_size_bytes(size):
    """Format bytes to human readable string"""
    if size is None:
        return "Unknown"
    for unit in ["B", "KB", "MB", "GB"]:
        if size < 1024:
            return f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TB"


def check_gphoto2():
    """Check if gphoto2 is installed"""
    try:
        result = subprocess.run(
            ["gphoto2", "--version"], capture_output=True, text=True, timeout=5
        )
        return result.returncode == 0
    except:
        return False


def detect_camera():
    """Check if KeyMission 360 is connected"""
    try:
        result = subprocess.run(
            ["gphoto2", "--auto-detect"], capture_output=True, text=True, timeout=10
        )
        return "KeyMission" in result.stdout or "04b0" in result.stdout
    except:
        return False


