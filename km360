def cmd_download(args):
    """Download files from camera"""
    print("=" * 60)
    print("Nikon KeyMission 360 - Download Tool")
    print("=" * 60)
    print()

    if not check_gphoto2():
        print("[!] gphoto2 not installed!")
        return 1

    if not detect_camera():
        print("[!] Camera not found!")
        return 1

    output_dir = args.output or "."
    os.makedirs(output_dir, exist_ok=True)

    if args.all:
        # Download all files
        result = subprocess.run(
            ["gphoto2", "--list-files"], capture_output=True, text=True, timeout=30
        )

        files = []
        for line in result.stdout.split("\n"):
            if line.strip().startswith("#"):
                parts = line.strip().split()
                if len(parts) >= 2:
                    num = int(parts[0][1:])
                    name = parts[1]
                    files.append((num, name))

        if not files:
            print("No files found on camera.")
            return 0

        print(f"Found {len(files)} files to download.\n")

        success_count = 0
        failed_files = []

        # First pass: identify which files already exist
        existing_files = []
        files_to_download = []

        for num, name in files:
            output_path = os.path.join(output_dir, name)
            if os.path.exists(output_path) and not args.force and not args.no_skip:
                existing_files.append((num, name, output_path))
            else:
                files_to_download.append((num, name, output_path))

        if existing_files:
            print(
                f"Found {len(existing_files)} existing file(s) (will skip unless --force):"
            )
            for _, name, _ in existing_files[:5]:
                print(f"  ⏭ {name}")
            if len(existing_files) > 5:
                print(f"  ... and {len(existing_files) - 5} more")
            print()

        print(f"Downloading {len(files_to_download)} file(s)...\n")

        for i, (num, name, output_path) in enumerate(files_to_download, 1):
            print(f"[{i}/{len(files_to_download)}] ", end="")

            success, message, checksum = download_file(
                num,
                output_path,
                max_retries=args.retries,
                verify=not args.no_verify,
                show_progress=False,
                inject_metadata=not args.no_metadata,
                force=args.force or args.no_skip,
            )

            if success:
                print(f"{message}")
                success_count += 1
            else:
                print(f"✗ {name} - {message}")
                failed_files.append((name, message))

        # Verify existing files if requested
        if existing_files and not args.no_verify and not args.force:
            print(f"\nVerifying {len(existing_files)} existing file(s)...")
            for num, name, output_path in existing_files:
                checksum = calculate_checksum(output_path)
                if checksum:
                    success_count += 1

        print(f"\n{'=' * 50}")
        print(f"Complete: {success_count}/{len(files)} files")

        if failed_files:
            print("\nFailed files:")
            for name, error in failed_files:
                print(f"  • {name}: {error}")

        # Check for merge candidates among downloaded files
        if not args.no_merge_check and files_to_download:
            _check_merge_candidates([f[1] for f in files_to_download], output_dir)

        return 0 if not failed_files else 1

    elif args.file_num:
        # Download single file
        name, _ = get_file_info(args.file_num)
        if not name:
            print(f"[!] File #{args.file_num} not found on camera")
            return 1

        output_path = args.output or name
        if os.path.isdir(output_path):
            output_path = os.path.join(output_path, name)

        success, message, checksum = download_file(
            args.file_num,
            output_path,
            max_retries=args.retries,
            verify=not args.no_verify,
            show_progress=True,
            inject_metadata=not args.no_metadata,
            force=args.force or args.no_skip,
        )

        print(f"\n{message}")
        return 0 if success else 1

    else:
        print("[!] Please specify a file number or use --all")
        return 1


