def cmd_youtube(args):
    """Inject 360° metadata for YouTube"""
    print("=" * 60)
    print("KeyMission 360 YouTube Export")
    print("=" * 60)
    print()

    if not args.input:
        print("[!] Please specify an input file or directory")
        return 1

    if args.batch:
        # Batch process directory
        video_exts = [".mp4", ".mov", ".avi", ".mkv", ".m4v", ".3gp"]
        video_files = [
            f for f in Path(args.input).iterdir() if f.suffix.lower() in video_exts
        ]

        if not video_files:
            print(f"No video files found in {args.input}")
            return 0

        print(f"Found {len(video_files)} videos to process")
        print()

        success_count = 0
        tagged_count = 0
        failed_count = 0

        for i, video_file in enumerate(video_files, 1):
            print(f"[{i}/{len(video_files)}] Processing: {video_file.name}")
            success, msg = _process_youtube_file(
                str(video_file), in_place=args.in_place
            )
            if success:
                if msg == "already_tagged":
                    tagged_count += 1
                else:
                    success_count += 1
            else:
                failed_count += 1
                print(f"  ✗ Failed: {msg}")
            print()

        print(
            f"Done! {success_count} tagged, {tagged_count} already had tags, {failed_count} failed"
        )
        return 0 if failed_count == 0 else 1

    else:
        # Single file
        success, msg = _process_youtube_file(
            args.input, args.output, in_place=args.in_place
        )
        if success:
            print("\n✓ Export complete!")
            print("\nUpload to YouTube and it will automatically recognize")
            print("this as a 360° video with full spherical playback.")
            return 0
        else:
            print(f"\n✗ Export failed: {msg}")
            return 1


def _process_youtube_file(input_file, output_file=None, in_place=False):
    """Process a single video file for YouTube 360° metadata"""
    input_path = Path(input_file)

    if not input_path.exists():
        return False, f"File not found: {input_file}"

    if input_path.suffix.lower() not in [
        ".mp4",
        ".mov",
        ".avi",
        ".mkv",
        ".m4v",
        ".3gp",
    ]:
        return False, f"Unsupported format: {input_path.suffix}"

    # Determine output path
    if output_file is None:
        if in_place:
            output_file = input_file
        else:
            output_file = str(input_path.with_suffix("")) + "_youtube.mp4"

    # Check for exiftool first (preferred method)
    exiftool_path = None
    for path in ["exiftool", "/usr/bin/exiftool", "/usr/local/bin/exiftool"]:
        try:
            result = subprocess.run([path, "-ver"], capture_output=True, timeout=5)
            if result.returncode == 0:
                exiftool_path = path
                break
        except:
            continue

    if exiftool_path and in_place:
        # Use exiftool for in-place modification
        try:
            cmd = [
                exiftool_path,
                "-XMP-GSpherical:Spherical=true",
                "-XMP-GSpherical:Stitched=true",
                "-XMP-GSpherical:StitchingSoftware=KeyMission360Tools",
                "-XMP-GSpherical:ProjectionType=equirectangular",
                "-XMP-GSpherical:StereoMode=mono",
                "-overwrite_original",
                input_file,
            ]
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            if result.returncode == 0:
                print("  ✓ Metadata injected (exiftool)")
                return True, "success"
            else:
                error_msg = (
                    result.stderr.strip() if result.stderr else "exiftool failed"
                )
                return False, error_msg
        except Exception as e:
            return False, str(e)

    # Fallback to ffmpeg (creates new file)
    temp_output = (
        output_file + ".temp.mp4" if output_file == input_file else output_file
    )

    try:
        cmd = [
            "ffmpeg",
            "-y",
            "-i",
            input_file,
            "-c",
            "copy",
            "-movflags",
            "+faststart",
            "-metadata:s:v:0",
            "spherical=1",
            "-metadata:s:v:0",
            "stereo_mode=mono",
            "-metadata:s:v:0",
            "projection_type=equirectangular",
            temp_output,
        ]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)

        if result.returncode == 0:
            if temp_output != output_file:
                shutil.move(temp_output, output_file)
            print("  ✓ Metadata injected (ffmpeg)")
            return True, "success"
        else:
            if os.path.exists(temp_output):
                os.remove(temp_output)
            return False, "ffmpeg failed"
    except Exception as e:
        return False, str(e)


