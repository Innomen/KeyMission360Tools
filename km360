    print("  [✓] sysfs authorized toggle (may need sudo)")
    methods.append("sysfs")

    if not methods:
        print("\n✗ No automatic reset methods available!")
        print("Install libusb1 for automatic reset:")
        print("  pip install libusb1")
        return 1

    if not args.force:
        is_interactive = sys.stdin.isatty() if hasattr(sys.stdin, "isatty") else False
        if is_interactive:
            try:
                response = input(
                    "\nReset USB port? This will briefly disconnect the camera. [y/N]: "
                )
                if response.lower() != "y":
                    print("Cancelled.")
                    return 0
            except EOFError:
                print("\n(Running non-interactively, use --force to skip confirmation)")
                return 1
        else:
            print("\n(Non-interactive mode, use --force to skip confirmation)")
            return 1

    print("\nAttempting USB reset...")

    # Try methods in order of preference

    # Method 1: libusb1/pyusb (most reliable)
    if has_libusb:
        try:
            print("  Trying USB library reset...")
            import usb.core

            dev = usb.core.find(idVendor=VENDOR_ID, idProduct=PRODUCT_ID)
            if dev:
                dev.reset()
                print("\n✓ USB device reset successful!")
                print("  Wait a few seconds for the camera to reconnect.")
                return 0
        except ImportError:
            pass  # Try next method
        except Exception as e:
            print(f"    USB library reset failed: {e}")

    # Method 2: usbreset command
    if has_usbreset and bus and addr:
        try:
            print("  Trying usbreset utility...")
            usbdev = f"/dev/bus/usb/{bus:03d}/{addr:03d}"
            result = subprocess.run(
                ["usbreset", usbdev], capture_output=True, text=True, timeout=10
            )
            if result.returncode == 0:
                print("\n✓ USB device reset successful!")
