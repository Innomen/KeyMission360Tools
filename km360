def cmd_merge(args):
    """
    Losslessly merge/concatenate video files while preserving 360° metadata.

    This command uses ffmpeg's concat demuxer to losslessly merge videos
    without re-encoding. It also preserves or re-injects 360° spherical
    metadata so YouTube will recognize the merged video as 360° content.

    Smart Auto-detection:
      By default, the tool analyzes input files to detect if they appear
      to be parts of a single recording session. Use --auto to force
      auto-detection, or --no-auto to disable it.

      Detection criteria:
      - Sequential file naming (e.g., DSCN0016.MP4, DSCN0017.MP4)
      - Similar creation timestamps (within gap-tolerance)
      - Matching video parameters (codec, resolution, frame rate)
    """
    print("=" * 60)
    print("KeyMission 360 - Video Merge Tool")
    print("=" * 60)
    print()

    if not args.inputs:
        print("[!] No input files specified")
        return 1

    # Expand any glob patterns and validate files
    input_files = []
    for pattern in args.inputs:
        expanded = glob.glob(pattern)
        if expanded:
            input_files.extend(expanded)
        elif os.path.exists(pattern):
            input_files.append(pattern)

    if not input_files:
        print("[!] No valid input files found")
        return 1

    # Sort and deduplicate
    input_files = sorted(set(input_files))

    # Smart auto-detection
    use_auto = args.auto
    if not args.no_auto and not args.auto and len(input_files) >= 2:
        # Check if files look like they might be sequential
        first_name = Path(input_files[0]).stem
        last_name = Path(input_files[-1]).stem

        # Extract numbers from filenames
        import re

        first_nums = re.findall(r"\d+", first_name)
        last_nums = re.findall(r"\d+", last_name)

        if first_nums and last_nums:
            first_seq = int(first_nums[-1])
            last_seq = int(last_nums[-1])

            # If sequential-looking files with gaps or many files
            if last_seq > first_seq and len(input_files) >= 2:
                gap = last_seq - first_seq + 1
                if gap > len(input_files) or len(input_files) > 3:
                    print(
                        f"Detected {len(input_files)} files with sequence numbers {first_seq} to {last_seq}"
                    )
                    if not args.force:
                        resp = input(
                            "Use smart auto-detection to find continuous recording sessions? [Y/n]: "
                        )
                        if resp.lower() not in ["n", "no"]:
                            use_auto = True
                    else:
                        use_auto = True

    # Auto-detect mode - find related files
    if use_auto:
        print("\nRunning auto-detection for recording sessions...")
        input_files = _detect_recording_sessions(input_files, args.gap_tolerance)
        if not input_files:
            print("[!] No files found that match the auto-detection criteria")
            return 1
        print()

    # Validate all input files exist and are videos
    valid_files = []
    for f in input_files:
        path = Path(f)
        if not path.exists():
            print(f"[!] File not found: {f}")
            continue
        if path.suffix.lower() not in [".mp4", ".mov", ".avi", ".mkv", ".m4v", ".3gp"]:
            print(f"[!] Skipping non-video file: {f}")
            continue
        valid_files.append(f)

    if len(valid_files) < 2:
        print("[!] Need at least 2 video files to merge")
        return 1

    input_files = valid_files

    print(f"Files to merge ({len(input_files)}):")
    total_size = 0
    for i, f in enumerate(input_files, 1):
        size = Path(f).stat().st_size
        total_size += size
        print(f"  {i}. {Path(f).name} ({format_size_bytes(size)})")
    print(f"\nTotal input size: {format_size_bytes(total_size)}")
    print(f"Output: {args.output}")
    print()

    # Detect-only mode
    if args.detect_only:
        print("[Detect-only mode] The following files would be merged:")
        for f in input_files:
            print(f"  - {f}")
        return 0

    # Check output file doesn't exist
    output_path = Path(args.output)
    if output_path.exists():
        response = input(
            f"[!] Output file exists: {args.output}\n    Overwrite? (y/N): "
        )
        if response.lower() != "y":
            print("Cancelled.")
            return 0

    # Check ffmpeg
    try:
        result = subprocess.run(["ffmpeg", "-version"], capture_output=True, timeout=5)
        if result.returncode != 0:
            print("[!] ffmpeg not found. Please install ffmpeg.")
            return 1
    except:
