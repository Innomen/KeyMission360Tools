    if args.all:
        # Delete all files
        result = subprocess.run(
            ["gphoto2", "--list-files"], capture_output=True, text=True, timeout=30
        )

        files = []
        for line in result.stdout.split("\n"):
            if line.strip().startswith("#"):
                parts = line.strip().split()
                if len(parts) >= 2:
                    num = int(parts[0][1:])
                    name = parts[1]
                    files.append((num, name))

        if not files:
            print("No files found on camera.")
            return 0

        if not args.force:
            print(f"About to delete {len(files)} file(s) from camera:")
            for num, name in files[:5]:
                print(f"  • {name}")
            if len(files) > 5:
                print(f"  ... and {len(files) - 5} more")

            response = input("\nAre you sure? [yes/no]: ")
            if response.lower() != "yes":
                print("Cancelled.")
                return 0

        # One camera-native operation avoids invalidating per-file indices as
        # earlier objects disappear. Re-query so success means actually empty.
        result = subprocess.run(
            ["gphoto2", "--delete-all-files", "--recurse"],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if result.returncode != 0:
            print(f"Delete failed: {result.stderr.strip()}", file=sys.stderr)
            return 1
        remaining = subprocess.run(
            ["gphoto2", "--list-files"], capture_output=True, text=True, timeout=30
        )
        count = sum(
            1 for line in remaining.stdout.splitlines() if line.lstrip().startswith("#")
        )
        if count:
            print(
                f"Delete was incomplete: camera still reports {count} object(s)",
                file=sys.stderr,
            )
            return 1
        print(f"Deleted {len(files)} file(s); camera reports empty.")
        return 0

    elif args.file_num:
        # Delete single file
        name, _ = get_file_info(args.file_num)
        if not name:
            print(f"[!] File #{args.file_num} not found on camera")
            return 1

        if not args.force:
            print(f"About to delete: {name}")
            response = input("Are you sure? [yes/no]: ")
            if response.lower() != "yes":
                print("Cancelled.")
                return 0

        print(f"Deleting {name}...")
        result = subprocess.run(
            ["gphoto2", "--delete-file", str(args.file_num)],
            capture_output=True,
            text=True,
            timeout=60,
        )

        if result.returncode == 0:
            # File numbers are ephemeral. Confirm by name after deletion.
            check = subprocess.run(
                ["gphoto2", "--list-files"], capture_output=True, text=True, timeout=30
            )
            if any(
                line.split()[1] == name
                for line in check.stdout.splitlines()
                if line.lstrip().startswith("#") and len(line.split()) > 1
            ):
                print(f"✗ Camera still reports: {name}", file=sys.stderr)
                return 1
            print(f"✓ Deleted: {name}")
            return 0
        else:
            print(f"✗ Failed: {result.stderr}")
            return 1

    else:
        print("[!] Please specify a file number or use --all")
        return 1


