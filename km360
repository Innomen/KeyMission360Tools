def get_file_info(file_num):
    """Get file info from camera"""
    try:
        result = subprocess.run(
            ["gphoto2", "--list-files"], capture_output=True, text=True, timeout=30
        )
        for line in result.stdout.split("\n"):
            if line.strip().startswith(f"#{file_num}"):
                parts = line.strip().split()
                if len(parts) >= 3:
                    return parts[1], parts[2]
    except:
        pass
    return None, None


def parse_size(size_str):
    """Parse size string like '12MB' to bytes"""
    size_str = size_str.upper()
    multipliers = {"B": 1, "KB": 1024, "MB": 1024**2, "GB": 1024**3}
    for suffix, mult in multipliers.items():
        if size_str.endswith(suffix):
            try:
                return int(float(size_str[: -len(suffix)]) * mult)
            except:
                return None
    try:
        return int(size_str)
    except:
        return None


def calculate_checksum(filepath):
    """Calculate SHA256 checksum"""
    sha256_hash = hashlib.sha256()
    try:
        with open(filepath, "rb") as f:
            for byte_block in iter(lambda: f.read(4096), b""):
                sha256_hash.update(byte_block)
        return sha256_hash.hexdigest()
    except:
        return None


def download_file(
    file_num,
    output_path,
    max_retries=3,
    verify=True,
    show_progress=True,
    inject_metadata=True,
    skip_existing=True,
    force=False,
):
    """Download a file from camera

    Args:
        file_num: Camera file number
        output_path: Where to save the file
        max_retries: Max download attempts
        verify: Verify checksum after download
        show_progress: Show progress messages
        inject_metadata: Inject 360 metadata for videos
        skip_existing: Skip if file exists with same size (if not force)
        force: Re-download even if file exists
    """
    name, size_str = get_file_info(file_num)
    if not name:
        return False, "Could not get file info from camera", None

    camera_size = parse_size(size_str) if size_str else None

    # Check if output file already exists
    if os.path.exists(output_path) and not force:
        existing_size = os.path.getsize(output_path)

        if camera_size and existing_size == camera_size:
            # File exists with correct size
            if skip_existing:
                if verify:
                    if show_progress:
                        print(f"⏭ {name} - already exists (verifying...)", end=" ")
                    checksum = calculate_checksum(output_path)
                    if checksum:
                        if show_progress:
                            print("✓ verified)")
                        return True, "Already exists (verified)", checksum
                    else:
                        if show_progress:
                            print("⚠ checksum failed, re-downloading)")
                        # Fall through to re-download
                else:
                    if show_progress:
                        print(f"⏭ {name} - already exists")
                    return True, "Already exists", None
            else:
                # Don't skip, but note it exists
                if show_progress:
                    print(f"⚠ {name} - exists but re-downloading (skip_existing=False)")
        else:
            # Size mismatch - file is incomplete or different
            if show_progress:
                if camera_size:
                    print(
                        f"🔄 {name} - incomplete ({format_size_bytes(existing_size)} / {format_size_bytes(camera_size)})"
                    )
                else:
                    print(f"🔄 {name} - exists but size unknown, re-downloading")
            # Fall through to re-download
    elif os.path.exists(output_path) and force:
        if show_progress:
            print(f"🔄 {name} - forcing re-download")

    if show_progress:
        print(
            f"⬇ {name} ({format_size_bytes(camera_size)})"
            if camera_size
            else f"⬇ {name}"
        )

    temp_path = output_path + ".partial"

    temp_path = output_path + ".partial"

    for attempt in range(max_retries):
        if show_progress and attempt > 0:
            print(f"Retry attempt {attempt + 1}/{max_retries}...")

        try:
            if attempt > 0 and os.path.exists(temp_path):
                os.remove(temp_path)

            result = subprocess.run(
                ["gphoto2", "--get-file", str(file_num), f"--filename={temp_path}"],
                capture_output=True,
                timeout=300,
            )

            if result.returncode == 0:
                if not os.path.exists(temp_path):
                    last_error = "Download completed but temp file not found"
                    continue

                downloaded_size = os.path.getsize(temp_path)
                if camera_size and downloaded_size != camera_size:
                    last_error = f"Size mismatch: {downloaded_size} vs {camera_size}"
                    continue

                shutil.move(temp_path, output_path)

                # Inject 360 metadata for videos
                is_video = name.lower().endswith((".mp4", ".mov", ".avi"))
                if is_video and inject_metadata:
                    if show_progress:
                        print("Injecting 360° metadata for YouTube...")
                    _inject_metadata(output_path)

                if verify:
                    if show_progress:
                        print("Verifying checksum...")
                    checksum = calculate_checksum(output_path)
                    if checksum:
                        return True, "Download successful and verified", checksum
                    else:
                        last_error = "Checksum verification failed"
                        continue
                else:
                    return True, "Download successful", None
            else:
                stderr = result.stderr.decode() if result.stderr else "Unknown error"
                last_error = f"gphoto2 error: {stderr}"
                if "timeout" in stderr.lower():
                    time.sleep(2**attempt)
                    continue
                else:
                    break

        except subprocess.TimeoutExpired:
            last_error = "Download timeout"
            time.sleep(2**attempt)
            continue
        except Exception as e:
            last_error = f"Exception: {str(e)}"
            continue

    if os.path.exists(temp_path):
        try:
            os.remove(temp_path)
        except:
            pass

    return False, f"Failed after {max_retries} attempts: {last_error}", None


def _inject_metadata(input_file):
    """Inject 360° metadata for YouTube"""
    try:
        temp_output = input_file + ".yt_temp.mp4"
        cmd = [
            "ffmpeg",
            "-y",
            "-i",
            input_file,
            "-c",
            "copy",
            "-movflags",
            "+faststart",
            "-metadata:s:v:0",
            "spherical=1",
            "-metadata:s:v:0",
            "stereo_mode=mono",
            temp_output,
        ]
        result = subprocess.run(cmd, capture_output=True, timeout=120)
        if result.returncode == 0:
            os.replace(temp_output, input_file)
            return True
        else:
            if os.path.exists(temp_output):
                os.remove(temp_output)
    except:
        pass
    return False


