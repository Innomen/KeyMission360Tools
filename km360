def _install_udev_rules(remove=False):
    """Install udev rules for USB access"""
    udev_dir = Path("/etc/udev/rules.d")
    udev_file = udev_dir / "99-keymission360.rules"

    if remove:
        if udev_file.exists():
            try:
                subprocess.run(["sudo", "rm", str(udev_file)], check=True)
                subprocess.run(["sudo", "udevadm", "control", "--reload-rules"])
                print("✓ udev rules removed")
            except Exception as e:
                print(f"✗ Failed to remove udev rules: {e}")
                return 1
        else:
            print("udev rules not installed")
        return 0

    # Check if already installed
    if udev_file.exists():
        print("✓ udev rules already installed")
        return 0

    print("Installing udev rules for USB access...")
    print("  This allows non-root USB access to the camera")
    print()

    udev_content = """# Nikon KeyMission 360 USB rules
# Allows non-root access to camera
SUBSYSTEM=="usb", ATTR{idVendor}=="04b0", ATTR{idProduct}=="019f", MODE="0666", GROUP="plugdev"
"""

    # Write to temp file first
    temp_file = tempfile.NamedTemporaryFile(mode="w", delete=False, suffix=".rules")
    temp_file.write(udev_content)
    temp_file.close()

    try:
        # Use sudo to copy to system directory
        print(f"  Copying rules to {udev_file}...")
        result = subprocess.run(
            ["sudo", "cp", temp_file.name, str(udev_file)],
            capture_output=True,
            text=True,
        )

        if result.returncode != 0:
            print(f"✗ Failed to install udev rules: {result.stderr}")
            print("  Try running: sudo km360 install --udev")
            os.unlink(temp_file.name)
            return 1

        # Set permissions
        subprocess.run(["sudo", "chmod", "644", str(udev_file)], check=True)

        # Reload rules
        print("  Reloading udev rules...")
        subprocess.run(["sudo", "udevadm", "control", "--reload-rules"])
        subprocess.run(["sudo", "udevadm", "trigger"])

        os.unlink(temp_file.name)

        print("\n✓ udev rules installed successfully!")
        print()
        print("To apply rules to your user:")
        print("  1. Add yourself to plugdev group:")
        print("     sudo usermod -a -G plugdev $USER")
        print("  2. Log out and back in (or reboot)")
        print()
        print("After that, USB reset and camera access will work without sudo.")

    except Exception as e:
        print(f"✗ Error installing udev rules: {e}")
        os.unlink(temp_file.name)
        return 1

    return 0


