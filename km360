# =============================================================================
# Main Entry Point
# =============================================================================


def main():
    parser = argparse.ArgumentParser(
        prog="km360",
        description=f"""
KeyMission 360 - Comprehensive CLI Tool v{VERSION}

A complete command-line interface for the Nikon KeyMission 360 camera.
Provides camera control, file management, 360° viewing, and YouTube export.
        """,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  km360 check                     # Check dependencies and USB reset
  km360 deps --install            # Install missing dependencies
  km360 info                      # Show camera information
  km360 format                    # Format SD card (with confirmation)
  km360 format --force            # Format without confirmation
  km360 time                      # Sync camera time to system time
  km360 time --check              # Check current camera time
  km360 list                      # List all files on camera
  km360 download --all ~/Photos   # Download all files (skip existing)
  km360 download --all --force ~/Photos  # Re-download all
  km360 download 5 ~/video.mp4    # Download file #5
  km360 reset                     # Reset USB port (auto-fixes dependencies)
  km360 viewer photo.jpg          # View 360° image
  km360 youtube video.mp4         # Add YouTube 360° metadata
  km360 merge -o out.mp4 *.MP4    # Merge videos preserving 360° metadata
  km360 merge --auto -o out.mp4 DSCN*.MP4  # Auto-detect split recordings
  km360 wifi --ssid MyCamera      # Change WiFi name
  km360 settings --show           # Show all settings
  km360 install                   # Add to application menu
  km360 install --udev            # Install USB rules for non-root access

For detailed help on a command:
  km360 <command> --help

Requirements:
  - gphoto2: sudo apt-get install gphoto2
  - libusb1: pip install libusb1
  - numpy, pillow: pip install numpy pillow (for viewer)
  - opencv-python: pip install opencv-python (for video viewer)
  - ffmpeg: sudo apt-get install ffmpeg (for YouTube export)

License: MIT
        """,
    )

    parser.add_argument(
        "--version", "-v", action="version", version=f"%(prog)s {VERSION}"
    )

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Info command
    p_info = subparsers.add_parser("info", help="Show camera information")
    p_info.set_defaults(func=cmd_info)

    # Format command
    p_format = subparsers.add_parser("format", help="Format SD card via PTP")
    p_format.add_argument(
        "--storage",
        "-s",
        type=lambda x: int(x, 0),
        help="Specific storage ID (hex, e.g., 0x00010001)",
    )
    p_format.add_argument(
        "--force", "-f", action="store_true", help="Skip confirmation (DANGEROUS)"
    )
    p_format.add_argument(
        "--list", "-l", action="store_true", help="List storage devices only"
    )
    p_format.set_defaults(func=cmd_format)

    # Time command
    p_time = subparsers.add_parser("time", help="Sync camera time")
    p_time.add_argument(
        "--check",
        "-c",
        action="store_true",
        help="Only check current time, don't change",
    )
    p_time.set_defaults(func=cmd_time)

    # List command
    p_list = subparsers.add_parser("list", help="List files on camera")
    p_list.set_defaults(func=cmd_list)

    # Download command
    p_download = subparsers.add_parser("download", help="Download files from camera")
    p_download.add_argument(
        "file_num", nargs="?", type=int, help="File number to download"
    )
    p_download.add_argument("--output", "-o", help="Output directory or file")
    p_download.add_argument(
        "--all", "-a", action="store_true", help="Download all files"
    )
    p_download.add_argument(
        "--retries", "-r", type=int, default=3, help="Max retry attempts"
    )
    p_download.add_argument(
        "--no-verify", action="store_true", help="Skip checksum verification"
    )
    p_download.add_argument(
        "--no-metadata", action="store_true", help="Skip YouTube metadata injection"
    )
    p_download.add_argument(
        "--force", "-f", action="store_true", help="Re-download even if file exists"
    )
    p_download.add_argument(
        "--no-skip",
        action="store_true",
        help="Do not skip existing files (same as --force)",
    )
    p_download.add_argument(
        "--no-merge-check", action="store_true", help="Skip merge candidate detection"
    )
    p_download.set_defaults(func=cmd_download)

    # Delete command
    p_delete = subparsers.add_parser("delete", help="Delete files from camera")
    p_delete.add_argument("file_num", nargs="?", type=int, help="File number to delete")
    p_delete.add_argument("--all", "-a", action="store_true", help="Delete all files")
    p_delete.add_argument(
        "--force", "-f", action="store_true", help="Skip confirmation"
    )
    p_delete.set_defaults(func=cmd_delete)

    # Reset command
    p_reset = subparsers.add_parser("reset", help="Reset USB port")
    p_reset.add_argument("--force", "-f", action="store_true", help="Skip confirmation")
    p_reset.add_argument(
        "--auto-install",
        "-a",
        action="store_true",
        help="Auto-install missing dependencies",
    )
    p_reset.set_defaults(func=cmd_reset)

    # Viewer command
    p_viewer = subparsers.add_parser("viewer", help="Launch 360° viewer")
    p_viewer.add_argument("file", nargs="?", help="Image or video file to open")
    p_viewer.set_defaults(func=cmd_viewer)

    # YouTube command
    p_youtube = subparsers.add_parser(
        "youtube", help="Inject 360° metadata for YouTube"
    )
    p_youtube.add_argument("input", nargs="?", help="Input video file or directory")
    p_youtube.add_argument("--output", "-o", help="Output file (optional)")
    p_youtube.add_argument(
        "--batch", "-b", action="store_true", help="Batch process directory"
    )
    p_youtube.add_argument(
        "--in-place", "-i", action="store_true", help="Modify files in-place"
    )
    p_youtube.set_defaults(func=cmd_youtube)

    # WiFi command
    p_wifi = subparsers.add_parser("wifi", help="Configure WiFi settings")
    p_wifi.add_argument("--ssid", help="WiFi network name (SSID)")
    p_wifi.add_argument("--password", help="WiFi password")
    p_wifi.add_argument("--channel", type=int, help="WiFi channel (1-11)")
    p_wifi.set_defaults(func=cmd_wifi)

    # Settings command
    p_settings = subparsers.add_parser("settings", help="Camera settings")
    p_settings.add_argument(
        "--show", "-s", action="store_true", help="Show all settings"
    )
    p_settings.add_argument(
        "--whitebalance",
        choices=["auto", "daylight", "fluorescent", "tungsten"],
        help="Set white balance",
    )
    p_settings.add_argument("--copyright", help="Set copyright info")
    p_settings.add_argument(
        "--target", choices=["ram", "card", "sd"], help="Set capture target"
    )
    p_settings.set_defaults(func=cmd_settings)

    # Install command
    p_install = subparsers.add_parser(
        "install", help="Install desktop entry and udev rules"
    )
    p_install.add_argument(
        "--remove", "-r", action="store_true", help="Remove desktop entry"
    )
    p_install.add_argument(
        "--udev", "-u", action="store_true", help="Install udev rules for USB access"
    )
    p_install.set_defaults(func=cmd_install)

    # Deps command
    p_deps = subparsers.add_parser("deps", help="Check and install dependencies")
    p_deps.add_argument(
        "--check", "-c", action="store_true", help="Check all dependencies"
    )
    p_deps.add_argument(
        "--install", "-i", action="store_true", help="Interactive install"
    )
    p_deps.add_argument(
        "--install-all", "-a", action="store_true", help="Auto-install all missing"
    )
    p_deps.add_argument(
        "--for", dest="for_command", help="Check deps for specific command"
    )
    p_deps.add_argument(
        "--usb-reset",
        "-u",
        action="store_true",
        help="Also check USB reset capabilities",
    )
    p_deps.set_defaults(func=cmd_deps)

    # Merge command
    p_merge = subparsers.add_parser(
        "merge", help="Losslessly merge video files while preserving 360° metadata"
    )
    p_merge.add_argument(
        "inputs", nargs="+", help="Input video files to merge (in order)"
    )
    p_merge.add_argument(
        "--output", "-o", required=True, help="Output merged video file"
    )
    p_merge.add_argument(
        "--auto",
        "-a",
        action="store_true",
        help="Force auto-detect split files by filename pattern",
    )
    p_merge.add_argument(
        "--no-auto", action="store_true", help="Disable smart auto-detection"
    )
    p_merge.add_argument(
        "--detect-only",
        "-d",
        action="store_true",
        help="Only detect and show which files would be merged, do not merge",
    )
    p_merge.add_argument(
        "--gap-tolerance",
        "-g",
        type=float,
        default=3.0,
        help="Max seconds gap between files to consider same session (default: 3)",
    )
    p_merge.add_argument(
        "--force", "-f", action="store_true", help="Skip confirmation prompts"
    )
    p_merge.set_defaults(func=cmd_merge)

    # Check command (alias for deps --check --usb-reset)
    p_check = subparsers.add_parser("check", help="Check dependencies and system setup")
    p_check.add_argument(
        "--usb-reset",
        "-u",
        action="store_true",
        default=True,
        help="Check USB reset capabilities",
    )
    p_check.set_defaults(
        func=lambda args: cmd_deps(
            argparse.Namespace(
                check=True,
                usb_reset=args.usb_reset,
                install=False,
                install_all=False,
                for_command=None,
            )
        )
    )

    # GUI command
    p_gui = subparsers.add_parser("gui", help="Launch GUI (if available)")
    p_gui.set_defaults(func=cmd_gui)

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return 0

    try:
        return args.func(args)
    except KeyboardInterrupt:
        print("\n\n[!] Interrupted by user")
        return 130
    except Exception as e:
        print(f"\n[!] Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
